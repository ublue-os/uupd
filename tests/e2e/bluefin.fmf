description: |
  Test uupd upgrade on bluefin images
  
  Verifies that uupd correctly upgrades a bluefin bootc image.
  Tests the full upgrade cycle with a derived container image.

provision:
  how: virtual.testcloud
  image: ghcr.io/ublue-os/bluefin:stable
  flavor: bluefin

test:
  how: exec
  script:
    - dnf -y install uupd
    - bash tests/e2e/test-uupd-upgrade.sh

finish:
  how: exec
  script:
    - echo "bluefin e2e test completed"
