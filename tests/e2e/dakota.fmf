description: |
  Test uupd upgrade on dakota images
  
  Verifies that uupd correctly upgrades a dakota bootc image.
  Uses uutils for additional complexity (edge case).
  Tests the full upgrade cycle with a derived container image.

provision:
  how: bootc
  container-image: localhost/uupd-test
  image-builder: quay.io/centos-bootc/bootc-image-builder:stream10
  rootfs: xfs

test:
  how: exec
  script:
    - bash tests/e2e/test-uupd-upgrade.sh

finish:
  how: exec
  script:
    - echo "dakota e2e test completed"
