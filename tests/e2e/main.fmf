summary: Run uupd e2e tests with tmt bootc provision

discover:
  how: fmf
  directory: tests/e2e

prepare:
  - name: Install e2e test dependencies
    how: install
    package:
      - tmt
      - qemu-kvm
      - podman
      - rsync

execute:
  - name: Run uupd upgrade test
    how: exec
    script: tests/e2e/test-uupd-upgrade.sh

finish: []
