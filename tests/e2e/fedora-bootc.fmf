description: |
  Test uupd upgrade on fedora-bootc rawhide images
  
  Verifies that uupd correctly upgrades a fedora-bootc:rawhide image.
  Tests the full upgrade cycle with a derived container image.
  Important for catching regressions from Fedora changes.

provision:
  how: virtual.testcloud
  image: ghcr.io/fedora/fedora-bootc:rawhide
  flavor: fedora-bootc-rawhide

test:
  how: exec
  script:
    - dnf -y install uupd
    - bash tests/e2e/test-uupd-upgrade.sh

finish:
  how: exec
  script:
    - echo "fedora-bootc:rawhide e2e test completed"