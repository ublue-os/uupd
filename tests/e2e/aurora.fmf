description: |
  Test uupd upgrade on aurora images
  
  Verifies that uupd correctly upgrades an aurora bootc image.
  Tests the full upgrade cycle with a derived container image.
  Uses multi-stage build to include uupd in the tested image (issue #205).

provision:
  how: bootc
  container-image: localhost/uupd-test
  image-builder: quay.io/centos-bootc/bootc-image-builder:stream10
  rootfs: xfs

test:
  how: exec
  script:
    - bash tests/e2e/test-uupd-upgrade.sh

finish:
  how: exec
  script:
    - echo "aurora e2e test completed"
